program fact_64
    use iso_fortran_env, only: int64
    implicit none
    integer :: i, n
    integer(int64) :: factorial
    logical :: overflow

    do 
        print *, "Enter a non negative integeer):"
        read *, n
        if (n >= 0) exit  
        print*, "try again, the number must be non negative"
    end do

    factorial = 1_int64
    overflow = .false.
    do i = 1, n
        if (factorial > huge(factorial) / i) then
            overflow = .true.
            exit
        end if
        factorial = factorial * i
    end do

    if (overflow) then
        print *, "Overflow occurred. The factorial is too large to be represented."
    else
        print *, "Factorial:", factorial
    end if
end program fact_64

    !overflow means that the number is too big to be stored in the variable.
