program tables
    implicit none
    integer :: n

    do
        print *, "size 1 to 5; 0 finishes:"
        read *, n
        if (n == 0) exit
        if (n<1 .or. n>5) then     
            print*, "invalid size"
        else                        
            call print_tables(n)
        end if
    end do


    contains
        subroutine print_tables(size)
            implicit none
            integer, intent(in) :: size
            integer :: i,j

            do i=1,size
                do j=1,size
                    print *, i*j, multiply(i,j)  
                end do
            end do
        end subroutine print_tables
            
        integer function multiply(a,b) result(value)
            implicit none
            integer, intent(in) :: a,b
            value = a*b
        end function multiply

end program tables
