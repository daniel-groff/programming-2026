program conversion
    implicit none
    real :: a, b, cf, fc, x
    
    print*, "from celcius to FArenheit type 1 otherwise 2"
    read*, x

    if(x==1) then
        print*, "type temperature in celcius:"
        read*, a
        cf= ((a*1.8) + 32)
        print*, a,"celcius are equal to", cf, "farenheit"
     else 
        print*, "type temperature in farenheit"
        read*, b
        fc= (b-32)*1.8
        print*, b, "farenheit are equal to", fc , "celcius"

    end if
end program conversion
