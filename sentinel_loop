program sentinel_loop
  implicit none
  integer :: n
  do
    print*, "Enter -10 to 10; 0 finishes:"
    read*, n
    if (n == 0) exit
    if (n>= -10 .and. n<= 10) then
        print*, "square:", n*n
    else
        print*, "outside the allowed range"
    end if
  end do
end program sentinel_loop
